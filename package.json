{
  "name": "dsh-kkrpc",
  "version": "1.0.0",
  "description": "Bidirectional RPC bridge plugin for DeepSeek Harness powered by kkRPC.",
  "author": "MrThanlon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrThanlon/dsh-kkrpc.git"
  },
  "bugs": {
    "url": "https://github.com/MrThanlon/dsh-kkrpc/issues"
  },
  "homepage": "https://github.com/MrThanlon/dsh-kkrpc#readme",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "scripts": {
    "build": "tsc --emitDeclarationOnly && tsdown",
    "typecheck": "tsc --noEmit",
    "test:kkrpc": "tsx tests/kkrpc.ts"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-host-webserver": "0.2.2-rc.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "ws": "^8.22.2"
  },
  "dependencies": {
    "kkrpc": "^2.1.0"
  }
}
